@baseUrl = {{$dotenv API_BASE_URL}}
@routeId = {{$dotenv EXAMPLE_ROUTE_ID}}
@travelDate = {{$dotenv EXAMPLE_TRAVEL_DATE}}
@originStationId = {{$dotenv EXAMPLE_ORIGIN_STATION_ID}}
@destinationStationId = {{$dotenv EXAMPLE_DESTINATION_STATION_ID}}

### Configured routes
GET {{baseUrl}}/api/v1/routes
Accept: application/json

### Ordered stations
GET {{baseUrl}}/api/v1/routes/{{routeId}}/stations
Accept: application/json

### Train runs serving the selected segment
# Set EXAMPLE_TRAVEL_DATE to a date returned by the current demonstration seed.
GET {{baseUrl}}/api/v1/train-runs?travelDate={{travelDate}}&routeId={{routeId}}&originStationId={{originStationId}}&destinationStationId={{destinationStationId}}
Accept: application/json
