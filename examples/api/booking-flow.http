@baseUrl = http://localhost:8080
@originStationId = 20000000-0000-4000-8000-000000000001
@destinationStationId = 20000000-0000-4000-8000-000000000005
@trainRunId = replace-with-train-run-uuid
@seatId = replace-with-available-seat-uuid
@fareQuoteId = replace-with-fare-quote-uuid
@bookingId = replace-with-booking-uuid
@bookingReference = replace-with-booking-reference

### Available seats for one segment
GET {{baseUrl}}/api/v1/train-runs/{{trainRunId}}/available-seats?originStationId={{originStationId}}&destinationStationId={{destinationStationId}}
Accept: application/json

### Create fare quote
POST {{baseUrl}}/api/v1/fare-quotes
Content-Type: application/json

{
  "trainRunId": "{{trainRunId}}",
  "seatId": "{{seatId}}",
  "originStationId": "{{originStationId}}",
  "destinationStationId": "{{destinationStationId}}"
}

### Confirm booking
POST {{baseUrl}}/api/v1/bookings
Content-Type: application/json
Idempotency-Key: example-booking-request-0001

{
  "fareQuoteId": "{{fareQuoteId}}",
  "trainRunId": "{{trainRunId}}",
  "seatId": "{{seatId}}",
  "originStationId": "{{originStationId}}",
  "destinationStationId": "{{destinationStationId}}",
  "passenger": {
    "fullName": "Example Passenger",
    "email": "passenger@example.test",
    "phone": "+94770000000"
  }
}

### Lookup by reference
GET {{baseUrl}}/api/v1/bookings/reference/{{bookingReference}}
Accept: application/json

### Cancel booking
POST {{baseUrl}}/api/v1/bookings/{{bookingId}}/cancel
Content-Type: application/json

{}
