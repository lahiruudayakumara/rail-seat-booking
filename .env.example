# Database
POSTGRES_DB=rail_booking
POSTGRES_USER=rail_app
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgres://rail_app:local-development-only@db:5432/rail_booking?sslmode=disable

# Service ports and frontend API connection
API_PORT=8080
WEB_PORT=3000
VITE_API_BASE_URL=http://localhost:8080

# API runtime
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info
SERVICE_TIMEZONE=Asia/Colombo
BOOKING_HORIZON_DAYS=90
HTTP_REQUEST_TIMEOUT=10s

# Security and administrator access
# Replace these local placeholders with strong secret-manager values outside development.
MANAGEMENT_TOKEN_SECRET=local-development-management-secret-change-me
ADMIN_API_KEY=local-development-admin-key-change-me

# Booking inventory
SEAT_HOLD_TTL=10m

# Notification outbox
OUTBOX_POLL_INTERVAL=2s

# Passenger sessions
PASSENGER_SESSION_TTL=168h

# Payment provider
# Keep both provider values aligned: sandbox for zero-configuration local payments or payhere for hosted Sandbox checkout.
PAYMENT_PROVIDER=sandbox
VITE_PAYMENT_PROVIDER=sandbox
PAYMENT_PENDING_TTL=15m

# PayHere Sandbox
# Obtain merchant credentials from the PayHere Sandbox dashboard. Never commit real values.
PAYHERE_SANDBOX=true
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_RETURN_URL=http://localhost:3000/payment/return
PAYHERE_CANCEL_URL=http://localhost:3000/payment/cancel
# PayHere cannot call localhost; hosted checkout testing requires a public HTTPS notification URL.
PAYHERE_NOTIFY_URL=http://localhost:8080/api/v1/webhooks/payhere
