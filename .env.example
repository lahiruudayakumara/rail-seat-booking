POSTGRES_DB=rail_booking
POSTGRES_USER=rail_app
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgres://rail_app:local-development-only@db:5432/rail_booking?sslmode=disable
API_PORT=8080
WEB_PORT=3000
VITE_API_BASE_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info
SERVICE_TIMEZONE=Asia/Colombo
BOOKING_HORIZON_DAYS=90
HTTP_REQUEST_TIMEOUT=10s
MANAGEMENT_TOKEN_SECRET=local-development-management-secret-change-me
ADMIN_API_KEY=local-development-admin-key-change-me
SEAT_HOLD_TTL=10m
OUTBOX_POLL_INTERVAL=2s
PASSENGER_SESSION_TTL=168h
PAYMENT_PROVIDER=sandbox
PAYMENT_PENDING_TTL=15m
PAYHERE_SANDBOX=true
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_RETURN_URL=http://localhost:3000/payment/return
PAYHERE_CANCEL_URL=http://localhost:3000/payment/cancel
PAYHERE_NOTIFY_URL=http://localhost:8080/api/v1/webhooks/payhere
VITE_PAYMENT_PROVIDER=sandbox

# Runnable API examples (examples/api/*.http)
# Update the dynamic values from earlier API responses before running dependent requests.
API_BASE_URL=http://localhost:8080
EXAMPLE_ROUTE_ID=10000000-0000-4000-8000-000000000001
EXAMPLE_TRAVEL_DATE=2026-08-04
EXAMPLE_ORIGIN_STATION_ID=20000000-0000-4000-8000-000000000001
EXAMPLE_DESTINATION_STATION_ID=20000000-0000-4000-8000-000000000005
EXAMPLE_TRAIN_RUN_ID=replace-with-train-run-uuid
EXAMPLE_SEAT_ID=replace-with-available-seat-uuid
EXAMPLE_FARE_QUOTE_ID=replace-with-fare-quote-uuid
EXAMPLE_HOLD_ID=replace-with-hold-uuid
EXAMPLE_HOLD_TOKEN=replace-with-hold-management-token
EXAMPLE_BOOKING_ID=replace-with-booking-uuid
EXAMPLE_BOOKING_REFERENCE=replace-with-booking-reference
EXAMPLE_BOOKING_CONTACT=passenger@example.test
EXAMPLE_BOOKING_TOKEN=replace-with-booking-management-token
EXAMPLE_WAITLIST_ENTRY_ID=replace-with-waitlist-entry-uuid
EXAMPLE_WAITLIST_REFERENCE=replace-with-waitlist-reference
EXAMPLE_WAITLIST_CONTACT=waitlist-passenger@example.test
EXAMPLE_WAITLIST_TOKEN=replace-with-waitlist-management-token
